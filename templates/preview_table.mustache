{{!
    @template local_quickactions/preview_table

    Before/after preview rendered before applying any Quick Action.

    @copyright 2026 Tessa Demel
    @license   https://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later

    Context variables required for this template:
    * intro string Intro paragraph above the table.
    * rows array List of rows ({label, before, after}).
    * applyStr string Apply button label.
    * cancelStr string Cancel button label.

    Example context (json):
    {
        "intro": "The following changes will be applied:",
        "rows": [
            {"label": "Quiz 1", "before": "visible", "after": "hidden"}
        ],
        "applyStr": "Apply",
        "cancelStr": "Cancel"
    }
}}
<div class="local-quickactions-preview">
    <p class="local-quickactions-preview-intro">{{intro}}</p>
    <table class="local-quickactions-preview-table table table-sm">
        <thead>
            <tr>
                <th>{{#str}}name{{/str}}</th>
                <th>{{#str}}before, moodle{{/str}}</th>
                <th>{{#str}}after, moodle{{/str}}</th>
            </tr>
        </thead>
        <tbody>
            {{#rows}}
                <tr>
                    <td>{{label}}</td>
                    <td><code>{{before}}</code></td>
                    <td><code>{{after}}</code></td>
                </tr>
            {{/rows}}
        </tbody>
    </table>
    <div class="local-quickactions-preview-actions">
        <button type="button" class="btn btn-secondary" data-action="qa-cancel">{{cancelStr}}</button>
        <button type="button" class="btn btn-primary" data-action="qa-apply">{{applyStr}}</button>
    </div>
</div>
