{{!
    @template local_quickactions/dialog_dateshift
}}
<div class="local-quickactions-dialog">
    <h4 class="h6">{{#str}}action_dateshift, local_quickactions{{/str}}</h4>
    <p class="text-muted">Verschiebt alle Termine ausgewählter Aktivitäten so, dass das früheste Datum auf das gewählte Zieldatum fällt.</p>

    <div class="mb-3">
        <label for="qa-dateshift-target" class="form-label">Zieldatum & Uhrzeit</label>
        <input type="datetime-local" id="qa-dateshift-target" class="form-control" required>
    </div>

    <div class="d-flex gap-2">
        <button type="button" class="btn btn-secondary" data-action="qa-back">{{#str}}back{{/str}}</button>
        <button type="button" class="btn btn-primary" data-action="qa-preview">{{#str}}dialog_preview, local_quickactions{{/str}}</button>
    </div>
</div>
