{{!
    @template local_quickactions/dialog_move
    Context:
    * sections - [{id, name}]
}}
<div class="local-quickactions-dialog">
    <h4 class="h6">{{#str}}action_move, local_quickactions{{/str}}</h4>
    <p class="text-muted">{{#str}}action_move_desc, local_quickactions{{/str}}</p>

    <div class="mb-3">
        <label for="qa-move-target" class="form-label">{{#str}}action_move_target, local_quickactions{{/str}}</label>
        <select id="qa-move-target" class="form-select">
            {{#sections}}
                <option value="{{id}}">{{name}}</option>
            {{/sections}}
        </select>
    </div>

    <div class="d-flex gap-2">
        <button type="button" class="btn btn-secondary" data-action="qa-back">{{#str}}back{{/str}}</button>
        <button type="button" class="btn btn-primary" data-action="qa-preview">{{#str}}dialog_preview, local_quickactions{{/str}}</button>
    </div>
</div>
