{{!
    @template local_quickactions/dialog_completion_template
    Context:
    * candidates - [{cmid, label}]
}}
<div class="local-quickactions-dialog">
    <h4 class="h6">{{#str}}action_completion_template, local_quickactions{{/str}}</h4>
    <p class="text-muted">{{#str}}action_completion_template_desc, local_quickactions{{/str}}</p>

    <div class="mb-3">
        <label for="qa-completion-template-cm" class="form-label">{{#str}}action_completion_template_pick, local_quickactions{{/str}}</label>
        <select id="qa-completion-template-cm" class="form-select">
            {{#candidates}}
                <option value="{{cmid}}">{{label}}</option>
            {{/candidates}}
        </select>
    </div>

    <div class="d-flex gap-2">
        <button type="button" class="btn btn-secondary" data-action="qa-back">{{#str}}back{{/str}}</button>
        <button type="button" class="btn btn-primary" data-action="qa-preview">{{#str}}dialog_preview, local_quickactions{{/str}}</button>
    </div>
</div>
